# D&D AI — Environment Variables (example)
#
# Copy to .env (gitignored) and adjust. Per docs/PLAN.md §23.0, DATABASE_URL
# points at the deployed AWS dev RDS instance by default — see
# docs/DEVELOPMENT.md §3 for how to fetch credentials and open network access.
# A local Docker container is a fallback only, for when AWS is unreachable.
#
# NEVER put a real credential in this file or in .env. Runtime secrets come from
# AWS Secrets Manager or IAM database authentication — see CLAUDE.md rule 10 and
# docs/DATABASE_CONVENTIONS.md §27.3. .env itself is gitignored, but treat the
# master password you paste into DATABASE_URL as sensitive regardless.

# =============================================================================
# Application
# =============================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO

# =============================================================================
# Database — AWS dev (default)
# =============================================================================
# Build this from Terraform outputs plus the master secret's password:
#   terraform -chdir=terraform/environments/dev output database_endpoint
#   aws secretsmanager get-secret-value \
#     --secret-id $(terraform -chdir=terraform/environments/dev output -raw database_secret_name) \
#     --query SecretString --output text
#
# `sslmode=require` is not optional — the dev instance's parameter group sets
# rds.force_ssl=1, so a plain (non-SSL) connection is rejected outright. This
# doesn't come up against a local Docker container, which has no SSL
# configured at all, so it's easy to miss until you connect to something real.
#
# DATABASE_URL=postgresql+psycopg://dnd_admin:<password>@<endpoint>:5432/dnd_ai?sslmode=require

# =============================================================================
# Database — local fallback (AWS unreachable only)
# =============================================================================
# Matches: docker run -d --name dnd-ai-pg -e POSTGRES_PASSWORD=postgres \
#            -e POSTGRES_DB=dnd_ai -p 5432:5432 postgres:15
# Also set DND_AI_USE_LOCAL_POSTGRES=1 so tests/conftest.py uses this instead
# of provisioning an ephemeral database on dev.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dnd_ai
# DND_AI_USE_LOCAL_POSTGRES=1

# Separate database for manual local runs. tests/conftest.py provisions its own
# ephemeral database regardless (dev or local), so this isn't what the test
# suite uses.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dnd_ai_test

# =============================================================================
# AWS
# =============================================================================

AWS_REGION=us-east-1
AWS_PROFILE=dnd-ai-dev

# =============================================================================
# Secrets Manager references
# =============================================================================
# Names only — the application resolves values at runtime. Confirm the actual
# names with: terraform -chdir=terraform/environments/dev output

# SECRET_OPENAI=dnd-ai/dev/openai/api-key
# SECRET_DISCORD=dnd-ai/dev/discord/bot-token

# =============================================================================
# Feature flags
# =============================================================================

FEATURE_AI_NPC_DIALOGUE=false
FEATURE_DISCORD_INTEGRATION=false
FEATURE_FOUNDRY_INTEGRATION=false
