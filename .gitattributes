# tests/database/test_api_campaigns.py is stored with CRLF line endings
# (pre-existing, matching this repository's Windows-authored history).
# git's default core.whitespace does not include cr-at-eol, so it treats
# a line's own trailing CR (the first byte of its CRLF terminator) as
# ordinary "trailing whitespace" whenever that line is new or modified in
# a diff — flagging every such line in this already-CRLF file, even with
# no actual trailing space or tab, and in direct conflict with `ruff
# format`'s own line-ending normalization (which preserves this file's
# existing CRLF convention rather than rewriting it to LF). Enabling
# cr-at-eol here tells git that a trailing CR is this file's own line
# terminator, not blank content, so `git diff --check` and `ruff format
# --check` can both pass without rewriting the file's pre-existing line
# endings.
tests/database/test_api_campaigns.py whitespace=cr-at-eol

# Same rationale, hit by the Phase 13E-B manual-acceptance-fix pass:
# src/dnd_ai/api/auth.py is itself stored with CRLF line endings, and
# tests/database/test_role_grants.py's LF-stored blob is displayed with
# CRLF by `git diff` whenever core.autocrlf=true (as in this Windows-
# authored history) — either way, a line new or modified in a diff gets
# its own trailing CR misread as "trailing whitespace" without this
# attribute.
src/dnd_ai/api/auth.py whitespace=cr-at-eol
tests/database/test_role_grants.py whitespace=cr-at-eol

# Same rationale: src/dnd_ai/api/character_state.py is stored with CRLF line endings
# (as on main), so its added lines read as trailing whitespace to `git diff --check`.
src/dnd_ai/api/character_state.py whitespace=cr-at-eol

# The frozen seed files are hashed byte for byte (database/seeds/frozen_manifest.json, checked by
# tests/database/test_seed_idempotency.py), and the hashes are of LF content. With core.autocrlf=true
# (the Windows default in this history) a fresh checkout or worktree wrote them with CRLF and the 14
# frozen-seed tests failed on the new checkout alone. Pin exactly those 14 files to LF, and no other
# seed file (tests/unit/test_seed_line_endings.py keeps this list equal to the manifest).
database/seeds/rules.abilities.yaml text eol=lf
database/seeds/rules.classes.yaml text eol=lf
database/seeds/rules.conditions.yaml text eol=lf
database/seeds/rules.creature_types.yaml text eol=lf
database/seeds/rules.damage_types.yaml text eol=lf
database/seeds/rules.feats.yaml text eol=lf
database/seeds/rules.features.yaml text eol=lf
database/seeds/rules.languages.yaml text eol=lf
database/seeds/rules.proficiency_types.yaml text eol=lf
database/seeds/rules.resource_definitions.yaml text eol=lf
database/seeds/rules.skills.yaml text eol=lf
database/seeds/rules.species.yaml text eol=lf
database/seeds/rules.spells.yaml text eol=lf
database/seeds/rules.subclasses.yaml text eol=lf
