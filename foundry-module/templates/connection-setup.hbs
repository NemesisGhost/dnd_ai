<div class="dnd-ai-adapter-form">
  <fieldset>
    <legend>{{localize "DNDAI.Settings.ConnectionSetup.Name"}}</legend>
    <p class="hint">{{localize "DNDAI.Settings.ConnectionSetup.Hint"}}</p>

    <div class="form-group">
      <label>{{localize "DNDAI.Settings.ApiBaseUrl.Name"}}</label>
      <input type="text" name="apiBaseUrl" value="{{apiBaseUrl}}" placeholder="https://dnd-ai.example.com" />
    </div>

    <div class="form-group">
      <label>{{localize "DNDAI.Settings.ExternalSystemId.Name"}}</label>
      <input type="text" name="externalSystemId" value="{{externalSystemId}}" placeholder="00000000-0000-0000-0000-000000000000" />
    </div>

    <div class="form-group">
      <label>{{localize "DNDAI.Settings.CampaignId.Name"}}</label>
      <input type="text" name="campaignId" value="{{campaignId}}" placeholder="00000000-0000-0000-0000-000000000000" />
    </div>

    <div class="form-group">
      <label>{{localize "DNDAI.Settings.Credential.Name"}}</label>
      {{#if hasCredential}}
        <p class="masked-credential">{{maskedCredential}}</p>
      {{/if}}
      <input type="password" name="newCredential" autocomplete="off" placeholder="{{localize 'DNDAI.Settings.Credential.Placeholder'}}" />
      <p class="hint">{{localize "DNDAI.Settings.Credential.Hint"}}</p>
    </div>
  </fieldset>

  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-check"></i> {{localize "DNDAI.Settings.Save"}}</button>
  </footer>
</div>
