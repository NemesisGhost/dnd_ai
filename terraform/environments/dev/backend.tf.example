# Terraform Remote State Backend Configuration (OPTIONAL)
# 
# This file configures S3 as the remote backend for Terraform state storage.
# Remote state is recommended for team collaboration but not required for local development.
#
# SETUP INSTRUCTIONS:
# 
# 1. Create an S3 bucket for state storage:
#    aws s3 mb s3://YOUR-TERRAFORM-STATE-BUCKET --region us-east-1
#    aws s3api put-bucket-versioning --bucket YOUR-TERRAFORM-STATE-BUCKET --versioning-configuration Status=Enabled
#    aws s3api put-bucket-encryption --bucket YOUR-TERRAFORM-STATE-BUCKET --server-side-encryption-configuration '{
#      "Rules": [{
#        "ApplyServerSideEncryptionByDefault": {
#          "SSEAlgorithm": "AES256"
#        }
#      }]
#    }'
#
# 2. Create a DynamoDB table for state locking:
#    aws dynamodb create-table \
#      --table-name terraform-state-locks \
#      --attribute-definitions AttributeName=LockID,AttributeType=S \
#      --key-schema AttributeName=LockID,KeyType=HASH \
#      --billing-mode PAY_PER_REQUEST \
#      --region us-east-1
#
# 3. Copy this file to backend.tf and customize the values:
#    cp backend.tf.example backend.tf
#
# 4. Update the bucket name and other values below
#
# 5. Initialize Terraform with the backend:
#    terraform init -migrate-state
#
# IMPORTANT: Decide whether to commit backend.tf to git or keep it local
# - If bucket names are sensitive, add backend.tf to .gitignore
# - If shared across team, commit it (bucket name is not a secret)

terraform {
  backend "s3" {
    # REQUIRED: Replace with your actual S3 bucket name
    bucket = "YOUR-TERRAFORM-STATE-BUCKET"
    
    # REQUIRED: State file path within the bucket
    # Format: <project>/<environment>/terraform.tfstate
    key = "dnd-ai/dev/terraform.tfstate"
    
    # REQUIRED: AWS region where the bucket exists
    region = "us-east-1"
    
    # REQUIRED: Enable encryption for state file
    encrypt = true
    
    # REQUIRED: DynamoDB table for state locking (prevents concurrent modifications)
    dynamodb_table = "terraform-state-locks"
    
    # OPTIONAL: AWS profile to use (if not using default)
    # profile = "your-aws-profile"
    
    # OPTIONAL: KMS key for additional encryption
    # kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012"
    
    # OPTIONAL: Workspace key prefix (for managing multiple workspaces)
    # workspace_key_prefix = "workspaces"
  }
}

# ALTERNATIVE: For different environments, create separate backend configs:
# - dev/backend.tf with key = "dnd-ai/dev/terraform.tfstate"
# - staging/backend.tf with key = "dnd-ai/staging/terraform.tfstate"
# - prod/backend.tf with key = "dnd-ai/prod/terraform.tfstate"
